rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validCommon(recordId) {
      return request.resource.data.keys().hasAll(['id', 'version', 'schemaVersion'])
        && request.resource.data.id == recordId
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 11;
    }
    match /users/{userId}/_meta/{documentId} {
      allow read, write: if owner(userId);
    }
    match /users/{userId}/{table}/{recordId} {
      allow read: if owner(userId);
      allow create, update: if owner(userId)
        && table in ['movements','registers','drivers','vehicles','suppliers','paymentMethods','alerts']
        && validCommon(recordId);
      allow delete: if owner(userId)
        && table in ['movements','registers','drivers','vehicles','suppliers','paymentMethods','alerts'];
    }
  }
}
