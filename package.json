{
  "name": "mycar-plus",
  "version": "6.12.0",
  "private": true,
  "description": "MyCar+ para Web/PWA e Android com Capacitor",
  "scripts": {
    "sync": "npx cap sync android",
    "copy": "npx cap copy android",
    "open:android": "npx cap open android",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "build:release": "cd android && gradlew.bat bundleRelease",
    "sync:android": "npm run sync:web && npx cap sync android",
    "sync:web": "node scripts/sync-web-root.js",
    "validate:cohesion": "npm run validate:indicators && npm run validate:centralization && npm run validate:storage-sync && node scripts/validate-cohesion.js",
    "build:debug:linux": "cd android && ./gradlew assembleDebug",
    "validate:indicators": "node scripts/validate-indicators.js",
    "validate:centralization": "node scripts/validate-formula-centralization.js",
    "validate:storage-sync": "node scripts/validate-storage-sync.js"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
